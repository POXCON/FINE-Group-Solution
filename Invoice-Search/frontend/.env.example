# Backend API base URL (FastAPI). Required.
VITE_API_BASE_URL=http://localhost:8000

# Microsoft Entra ID (MSAL) configuration.
# Leave VITE_AZURE_CLIENT_ID / VITE_AZURE_AUTHORITY unset (empty) to use mock
# authentication for local development / E2E (any email + 8+ char password).
VITE_AZURE_TENANT_ID=
VITE_AZURE_CLIENT_ID=
VITE_AZURE_AUTHORITY=
VITE_AZURE_API_SCOPE=
