# Backend API base URL (FastAPI). Required.
VITE_API_BASE_URL=http://localhost:8000

# Amazon Cognito configuration.
# Leave unset / empty to use mock authentication for local development
# (any email + password with 8+ characters will sign in).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
