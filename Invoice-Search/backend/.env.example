# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated list of allowed origins, no wildcard with credentials) ---
CORS_ORIGINS=http://localhost:5173

# --- NTA Invoice Publication Web-API ---
# 番号検索エンドポイント（Ver.1, /num）。バックエンドが id/number/day/type/history を付与するため
# URL は「?クエリ」を含まないベースのみを指定する。
# App ID は国税庁への申請後にメールで発行される実値（公開リポジトリにコミットしないこと）。
# 参考: https://www.invoice-kohyo.nta.go.jp/web-api/index.html
INVOICE_APP_ID=
INVOICE_API_URL=https://web-api.invoice-kohyo.nta.go.jp/1/num
INVOICE_API_TIMEOUT_SECONDS=10
INVOICE_API_MAX_RETRIES=2

# --- Auth (Microsoft Entra ID) ---
# Set AUTH_DISABLED=false in production once Entra infra is provisioned.
# 以下の ID は非秘密（Tenant ID / Application ID URI）。秘密情報は含めない。
AUTH_DISABLED=true
AZURE_TENANT_ID=555dafe8-9dde-4f98-ac9b-904e08b28c58
# アクセストークンの aud は api://<appId> または 素の <appId> のいずれかで来る。
# 片方を設定すれば両形式を自動で許容する。
AZURE_API_AUDIENCE=api://76537176-b582-4055-8b3e-cf89e84e1c08
# ISSUER / JWKS_URI は未設定なら AZURE_TENANT_ID から自動導出される。
# 明示指定したい場合のみ設定する。
ISSUER=https://login.microsoftonline.com/555dafe8-9dde-4f98-ac9b-904e08b28c58/v2.0
JWKS_URI=https://login.microsoftonline.com/555dafe8-9dde-4f98-ac9b-904e08b28c58/discovery/v2.0/keys
# App Role によるアクセス制限。roles クレームに指定値が含まれないトークンは 403。
# 空のときはロール検証なし（dev 既定）。本番は admin を指定。
REQUIRED_APP_ROLE=admin
# JWKS キャッシュの TTL（秒）。既定 3600。
JWKS_CACHE_TTL_SECONDS=3600
