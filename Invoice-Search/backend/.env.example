# --- General ---
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated list of allowed origins, no wildcard with credentials) ---
CORS_ORIGINS=http://localhost:5173

# --- NTA Invoice Publication Web-API ---
# https://www.invoice-kohyo.nta.go.jp/ Web-API
INVOICE_APP_ID=
INVOICE_API_URL=https://www.invoice-kohyo.nta.go.jp/web-api/v1/announcement?id=
INVOICE_API_TIMEOUT_SECONDS=10
INVOICE_API_MAX_RETRIES=2

# --- Auth (Amazon Cognito) ---
# Set AUTH_DISABLED=false in production once Cognito infra is provisioned.
AUTH_DISABLED=true
COGNITO_USER_POOL_ID=
COGNITO_REGION=ap-northeast-1
COGNITO_APP_CLIENT_ID=
