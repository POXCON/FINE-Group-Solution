# Microsoft Entra ID (MSAL) configuration.
# These values are NON-secret (public client / SPA). Leave unset / empty to use
# mock authentication for local development (any email + 8+ char password signs in).
# See Common/infra/azure/entra-config.md for details.
VITE_AZURE_TENANT_ID=555dafe8-9dde-4f98-ac9b-904e08b28c58
VITE_AZURE_CLIENT_ID=76537176-b582-4055-8b3e-cf89e84e1c08
VITE_AZURE_AUTHORITY=https://login.microsoftonline.com/555dafe8-9dde-4f98-ac9b-904e08b28c58
VITE_AZURE_API_SCOPE=api://76537176-b582-4055-8b3e-cf89e84e1c08/access_as_user

# Invoice-Search app URL (target of the "Invoice number search" card).
VITE_INVOICE_SEARCH_URL=/invoice-search/
