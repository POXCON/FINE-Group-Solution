# Amazon Cognito configuration (shared user pool).
# Leave unset / empty to use mock authentication for local development
# (any email + password with 8+ characters will sign in).
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_REGION=ap-northeast-1

# Invoice-Search app URL (target of the "Invoice number search" card).
VITE_INVOICE_SEARCH_URL=https://example.cloudfront.net
